# Copy to infra/deploy.local.env (gitignored) and fill in. File PATHS only for secrets:
# infra/deploy.sh reads each value into its own environment and never prints it.
CLOUDFLARE_API_TOKEN_FILE=/path/to/cloudflare-api-token.txt
CLOUDFLARE_ACCOUNT_ID_FILE=/path/to/cloudflare-account-id.txt
BRAVE_API_KEY_FILE=/path/to/brave-api-key.txt
OPENROUTER_API_KEY_FILE=/path/to/openrouter-api-key.txt

# Public values.
ALLOWED_ORIGIN=https://<account>.github.io
SITE_URL=https://<account>.github.io/<repo>
WORKER_URL=https://<worker>.<account>.workers.dev
