{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["query", "weights", "local", "online", "usage"],
  "definitions": {
    "sourceRef": { "type": "object", "additionalProperties": false, "required": ["label", "url"],
      "properties": { "label": { "type": "string" }, "url": { "type": "string", "pattern": "^https?://" } } },
    "component": { "type": "object", "additionalProperties": false,
      "required": ["name", "value", "weight", "contribution", "sources"],
      "properties": {
        "name": { "enum": ["relevance", "ethics", "env", "proximity"] },
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "contribution": { "type": "number", "minimum": 0, "maximum": 1 },
        "sources": { "type": "array", "items": { "$ref": "#/definitions/sourceRef" } } } },
    "certification": { "type": "object", "additionalProperties": false,
      "required": ["kind", "label", "source_url", "checked"],
      "properties": {
        "kind": { "enum": ["b_corp", "fair_trade", "worker_coop", "one_percent_planet", "climate_neutral", "independent_retailer_assoc"] },
        "label": { "type": "string" }, "source_url": { "type": "string", "pattern": "^https://" },
        "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } },
    "signal": { "type": "object", "additionalProperties": false,
      "required": ["kind", "polarity", "claim", "source_url", "origin", "action_date"],
      "properties": {
        "kind": { "enum": ["labor", "governance", "environmental"] },
        "polarity": { "enum": ["positive", "negative"] },
        "claim": { "type": "string" }, "source_url": { "type": "string", "pattern": "^https?://" },
        "origin": { "enum": ["curated", "llm"] },
        "action_date": { "type": ["string", "null"] } } },
    "result": { "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "rank", "retailer", "matched_product", "snippet", "address", "distance_km", "certifications", "signals", "score", "components"],
      "properties": {
        "id": { "type": "string" }, "kind": { "enum": ["local", "online"] },
        "rank": { "type": "integer", "minimum": 1 },
        "retailer": { "type": "object", "additionalProperties": false, "required": ["name", "domain", "url"],
          "properties": { "name": { "type": "string", "minLength": 1 }, "domain": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https?://" } } },
        "matched_product": { "type": "string" }, "snippet": { "type": "string" },
        "address": { "type": ["string", "null"] }, "distance_km": { "type": ["number", "null"] },
        "certifications": { "type": "array", "items": { "$ref": "#/definitions/certification" } },
        "signals": { "type": "array", "items": { "$ref": "#/definitions/signal" } },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "components": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/definitions/component" } } } }
  },
  "properties": {
    "query": { "type": "object", "additionalProperties": false,
      "required": ["product", "city", "state", "canonical_name", "category"],
      "properties": { "product": { "type": "string" }, "city": { "type": "string" }, "state": { "type": "string" }, "canonical_name": { "type": "string" }, "category": { "type": "string" } } },
    "weights": { "type": "object", "additionalProperties": false,
      "required": ["relevance", "ethics", "env", "proximity"],
      "properties": { "relevance": { "type": "number" }, "ethics": { "type": "number" }, "env": { "type": "number" }, "proximity": { "type": "number" } } },
    "local": { "type": "array", "maxItems": 10, "items": { "$ref": "#/definitions/result" } },
    "online": { "type": "array", "maxItems": 10, "items": { "$ref": "#/definitions/result" } },
    "usage": { "type": "object", "additionalProperties": false,
      "required": ["brave_calls", "llm", "llm_tokens", "estimated_cost_usd"],
      "properties": {
        "brave_calls": { "type": "integer", "minimum": 0, "maximum": 6 },
        "llm": { "type": "array", "items": { "type": "object", "additionalProperties": false,
          "required": ["call", "model", "prompt_tokens", "completion_tokens", "cost_usd"],
          "properties": { "call": { "enum": ["normalize", "enrich"] }, "model": { "type": "string" },
            "prompt_tokens": { "type": "integer" }, "completion_tokens": { "type": "integer" }, "cost_usd": { "type": ["number", "null"] } } } },
        "llm_tokens": { "type": "integer" }, "estimated_cost_usd": { "type": "number" } } }
  }
}
