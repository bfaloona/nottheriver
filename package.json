{
  "name": "nottheriver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:proxy": "wrangler deploy --dry-run --outdir proxy/dist -c proxy/wrangler.jsonc",
    "build:zips": "node data/build-zips.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p proxy && tsc --noEmit -p tests",
    "lint": "eslint . && npm run typecheck",
    "test": "vitest run",
    "e2e": "playwright test",
    "scan:bundle": "sh .github/scripts/bundle-secret-scan.sh",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "tldts": "^7.4.14"
  }
}
